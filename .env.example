# Telegram MTProto credentials (from https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# OpenAI (used to classify whether a message is a promo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Backend API the listener pushes promos to
BACKEND_BASE_URL=https://api.example.com
BACKEND_API_KEY=

# Admin Telegram bot (separate from the MTProto listener)
# Create the bot via @BotFather and paste the token here.
BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use admin commands.
# Get your user ID from @userinfobot.
ADMIN_TELEGRAM_IDS=

# Optional: mirror every captured promo to this Telegram chat / channel.
# - Use your own user ID for a DM stream.
# - Use a channel ID (e.g. -1001234567890) for a public feed channel — the bot
#   must be added as an admin of that channel with "Post Messages" permission.
# Leave blank to disable live mirroring (data still flows to the backend / mock).
FEED_TELEGRAM_CHAT_ID=

# Optional tuning
QUEUE_DIR=./data/queue
CHANNELS_POLL_INTERVAL_MS=180000
LOG_LEVEL=info
